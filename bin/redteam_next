#!/usr/bin/env bash

set -euo pipefail

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ ! -d "$project_root/redteam_agent" ]]; then
    printf 'redteam_next: project package not found at %s/redteam_agent\n' "$project_root" >&2
    exit 1
fi

if [[ -n "${PYTHONPATH:-}" ]]; then
    export PYTHONPATH="$project_root:$PYTHONPATH"
else
    export PYTHONPATH="$project_root"
fi

python_bin="$project_root/.venv/bin/python"
if [[ ! -x "$python_bin" ]]; then
    python_bin="$(command -v python3 || true)"
fi
if [[ -z "$python_bin" ]]; then
    printf 'redteam_next: python3 not found; create .venv as documented in INSTALL.md\n' >&2
    exit 1
fi

if [[ "${1:-}" == "--cli" ]]; then
    shift
    exec "$python_bin" -m redteam_agent.cli "$@"
fi

open_browser=1
if [[ "${1:-}" == "--no-browser" ]]; then
    open_browser=0
    shift
fi

listen="127.0.0.1"

listen_explicit=0
port="8899"
web_args=("$@")
for ((index = 0; index < ${#web_args[@]}; index++)); do
    case "${web_args[$index]}" in
        --listen=*)
            listen="${web_args[$index]#*=}"
            listen_explicit=1
            ;;
        --listen)
            if ((index + 1 < ${#web_args[@]})); then
                listen="${web_args[$((index + 1))]}"
                listen_explicit=1
            fi
            ;;
        --port=*)
            port="${web_args[$index]#*=}"
            ;;
        --port)
            if ((index + 1 < ${#web_args[@]})); then
                port="${web_args[$((index + 1))]}"
            fi
            ;;
    esac
done

if ((listen_explicit == 0)); then
    web_args+=(--listen "$listen")
fi

if [[ "$listen" == "0.0.0.0" || "$listen" == "::" || "$listen" == "[::]" ]]; then
    browser_host="127.0.0.1"
else
    browser_host="$listen"
fi
dashboard_url="http://${browser_host}:${port}"

if ((open_browser)) && command -v xdg-open >/dev/null 2>&1; then
    (
        for ((attempt = 0; attempt < 50; attempt++)); do
            if command -v curl >/dev/null 2>&1 && curl -fsS --max-time 1 "$dashboard_url/" >/dev/null 2>&1; then
                xdg-open "$dashboard_url" >/dev/null 2>&1 || true
                exit 0
            fi
            sleep 0.1
        done
    ) &
fi

exec "$python_bin" -m redteam_agent.cli --web "${web_args[@]}"
