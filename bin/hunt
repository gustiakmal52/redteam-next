#!/usr/bin/env bash
# Hunting satu komando: passive -> live -> hidden -> exploit -> evidence.
set -euo pipefail

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
target="${1:-}"
if [[ -z "$target" ]]; then
    printf 'usage: hunt TARGET [extra redteam_next cli flags]\n' >&2
    exit 2
fi
shift

stamp="$(date -u +%Y%m%dT%H%M%SZ)"
slug="$(printf '%s' "$target" | tr -c 'A-Za-z0-9_.-' '_')"
out="${RTN_OUT:-${project_root}/evidence/hunt-${stamp}-${slug}}"
mkdir -p "$(dirname -- "$out")"

printf 'REDTEAM NEXT // HUNT  target=%s  out=%s\n' "$target" "$out"
printf 'ZERO REFUSAL / ANTI-N/A / ANTI-HALU  preset=full  traffic=%s\n' "${RTN_TRAFFIC:-FAST}"

exec "${project_root}/bin/redteam_next" --cli "$target" \
    --preset full \
    --offensive \
    --traffic "${RTN_TRAFFIC:-FAST}" \
    --deep-assets \
    --secret-discovery \
    --auth-flow \
    --source-maps \
    --max-requests "${RTN_MAX_REQUESTS:-3000}" \
    --bypass-budget "${RTN_BYPASS_BUDGET:-120}" \
    --max-depth "${RTN_MAX_DEPTH:-2}" \
    --output-dir "$out" \
    "$@"
